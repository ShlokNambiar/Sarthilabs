{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/chat/**",
              "components/core/**",
              "components/marketing/**",
              "components/navigation/**",
              "ui_kits/grok-bot/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnouncementPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:badge|title|detail|href|icon|style|key|ref|className|style|children)$/]",
        "message": "<AnnouncementPill> doesn't accept that prop. Declared props: badge, title, detail, href, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|neutral|violet|live|bare)$/]",
        "message": "<Badge> tone must be one of 'accent' | 'neutral' | 'violet' | 'live' | 'bare'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BotAvatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|size|badge|shape|style|key|ref|className|style|children)$/]",
        "message": "<BotAvatar> doesn't accept that prop. Declared props: color, size, badge, shape, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BotAvatar'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:bars|wedge|disc)$/]",
        "message": "<BotAvatar> shape must be one of 'bars' | 'wedge' | 'disc'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconPosition|fullWidth|disabled|href|as|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconPosition, fullWidth, disabled, href, as, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Button> iconPosition must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a|div)$/]",
        "message": "<Button> as must be one of 'button' | 'a' | 'div'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|padding|radius|interactive|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, padding, radius, interactive, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:surface|recessed|outline|raised)$/]",
        "message": "<Card> tone must be one of 'surface' | 'recessed' | 'outline' | 'raised'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|from|maxWidth|style|key|ref|className|style|children)$/]",
        "message": "<ChatBubble> doesn't accept that prop. Declared props: children, from, maxWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute[name.name='from'] > Literal[value!=/^(?:user|bot)$/]",
        "message": "<ChatBubble> from must be one of 'user' | 'bot'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:lines|copyable|windowChrome|style|key|ref|className|style|children)$/]",
        "message": "<CodeBlock> doesn't accept that prop. Declared props: lines, copyable, windowChrome, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Composer'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|onSend|style|key|ref|className|style|children)$/]",
        "message": "<Composer> doesn't accept that prop. Declared props: placeholder, value, onChange, onSend, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|children|footerLabel|footerHref|padding|style|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: title, body, children, footerLabel, footerHref, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradientRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|width|radius|style|key|ref|className|style|children)$/]",
        "message": "<GradientRule> doesn't accept that prop. Declared props: height, width, radius, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|style|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='strokeWidth'] > Literal[value!=/^(?:light|regular)$/]",
        "message": "<Icon> strokeWidth must be one of 'light' | 'regular'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|variant|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: name, size, variant, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|solid|inverse)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'solid' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|icon|type|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, onChange, placeholder, icon, type, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:recessed|raised)$/]",
        "message": "<Input> tone must be one of 'recessed' | 'raised'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Input> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|actions|sticky|style|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: items, actions, sticky, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewsCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:artwork|artworkLabel|category|date|title|href|style|key|ref|className|style|children)$/]",
        "message": "<NewsCard> doesn't accept that prop. Declared props: artwork, artworkLabel, category, date, title, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlanCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|features|action|actionVariant|onAction|style|key|ref|className|style|children)$/]",
        "message": "<PlanCard> doesn't accept that prop. Declared props: title, body, features, action, actionVariant, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlanCard'] > JSXAttribute[name.name='actionVariant'] > Literal[value!=/^(?:primary|secondary|outline)$/]",
        "message": "<PlanCard> actionVariant must be one of 'primary' | 'secondary' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|body|align|size|action|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, body, align, size, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg|xl)$/]",
        "message": "<SectionHeading> size must be one of 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='SplitButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|items|onSelect|size|style|key|ref|className|style|children)$/]",
        "message": "<SplitButton> doesn't accept that prop. Declared props: children, items, onSelect, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SplitButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<SplitButton> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: items, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThreadListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|preview|time|color|shape|unread|active|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ThreadListItem> doesn't accept that prop. Declared props: name, preview, time, color, shape, unread, active, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThreadListItem'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:bars|wedge|disc)$/]",
        "message": "<ThreadListItem> shape must be one of 'bars' | 'wedge' | 'disc'."
      }
    ]
  },
